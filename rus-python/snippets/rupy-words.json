{
  "вывести": {
    "prefix": "вывести",
    "body": "вывести \"${1}\"",
    "description": "Печатает текст или значение в консоль"
  },
  "ввод": {
    "prefix": "ввод",
    "body": "ввод ${1} \"${2:Введите: }\"",
    "description": "Запрашивает ввод данных (ввод имя_переменной \"Текст\")"
  },
  "использовать": {
    "prefix": "использовать",
    "body" : "использовать <модуль>",
    "description": [
      "импортирует python модуль.",
      "русификация модулей будет добавляться постепенно.",
      "",
      "подсказок по импортируемым модулям не будет(не знаю как)."
  ]
  },
  "из": {
    "prefix": "из",
    "body": "из $1<модуль> использовать $2<что-то>",
    "description": [
      "импортирует что-то из модуля.",
      "русификация модулей будет добавляться постепенно.",
      "",
      "подсказок по импортируемым модулям не будет(не знаю как)."
    ]
  },


  "пусть": {
    "prefix": "пусть",
    "body": "пусть ${1} = ${2}",
    "description": "Создает новую переменную"
  },
  "функция": {
    "prefix": "функция",
    "body": [
        "функция ${1:имя} ${2:аргументы}",
        "\t$0",
        "конец"
    ],
    "description": "Функция(ну тут наверно \nобъяснять что это такое,но на \nкрайний случай):\n \nфункция поздороваться имя\n  вывод имя\nконец)"
  },
  "вернуть": {
    "prefix": "вернуть",
    "body": "вернуть ${0}",
    "description": "Возвращает значение из функции"
  },
  "если": {
    "prefix": "если",
    "body": [
      "если ${1}",
      "\t$0",
      "конец"
    ],
    "description": "Блок условия"
  },
  "иначе": {
    "prefix": "иначе",
    "body": [
      "иначе",
      "\t$0"
    ],
    "description": "Блок 'иначе' для условия"
  },
  "для": {
    "prefix": "для",
    "body": [
      "для ${1:номер} ${2} раза",
      "\t$0",
      "конец"
    ],
    "description": "Цикл (для имя количество раза)"
  },
  "класс": {
    "prefix": "класс",
    "body": [
      "класс ${1}",
      "\t$0",
      "конец"
    ],
    "description": "Создать новый класс"
  },
  "создать": {
    "prefix": "создать",
    "body": [
      "создать ${1}",
      "\t$0",
      "конец"
    ],
    "description": "Конструктор класса"
  },
  "добавить": {
    "prefix": "добавить",
    "body": "добавить ${1}",
    "description": "Метод списка: ф.добавить значение"
  },
  "удалить": {
    "prefix": "удалить",
    "body": "удалить ${1}",
    "description": "Метод списка: ф.удалить значение"
  },
  "размер": {
    "prefix": "размер",
    "body": "размер",
    "description": "Метод списка: ф.размер (возвращает длину)"
  },
  "очистить": {
    "prefix": "очистить",
    "body": "очистить",
    "description": "Метод списка: ф.очистить (удаляет всё)"
  },
  "это": {
    "prefix": "это",
    "body": "это.",
    "description": "Обращение к полям класса (self.)"
  },
  "попробовать": {
    "prefix": "попробовать",
    "body": [
      "попробовать",
      "\t${1}",
      "отловить",
      "\t$0",
      "конец"
    ],
    "description": "Обработка ошибок (try...except)"
  },
  "конец": {
    "prefix": "конец",
    "body": "конец",
    "description": "Завершить блок кода"
  }
}